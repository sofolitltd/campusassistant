{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "campusassistant (production — .env)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=.env"]
    },
    {
      "name": "campusassistant (Android emulator — .env.local)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=.env.local"]
    },
    {
      "name": "campusassistant (LAN device — .env.lan)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=.env.lan"]
    },
    {
      "name": "campusassistant (.env, profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": ["--dart-define-from-file=.env"]
    },
    {
      "name": "campusassistant (.env, release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": ["--dart-define-from-file=.env"]
    }
  ]
}
