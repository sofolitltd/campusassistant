# ─── API URL ────────────────────────────────────────────
# Production:
BASE_URL=https://your-api-url/api/v1
# Local dev, Android emulator: http://10.0.2.2:8080/api/v1
# Local dev, real device on same WiFi/hotspot: http://<your-lan-ip>:8080/api/v1

# ─── API Key (X-API-Key header) ────────────────────────
API_KEY=your-api-key

# Firebase Console → Project Settings → Cloud Messaging → Web configuration
# → Web Push certificates → Generate key pair. Required for web push only.
FCM_VAPID_KEY=

# ─── AdMob (Google Mobile Ads) — optional overrides ────
# Unset = Google's official public TEST IDs are used everywhere (safe,
# never real traffic). Only set when ready to ship to production.
# ADMOB_ANDROID_APP_ID=
# ADMOB_BANNER_AD_UNIT_ID_ANDROID=
# ADMOB_REWARDED_AD_UNIT_ID_ANDROID=
